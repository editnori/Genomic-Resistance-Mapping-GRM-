+
+#[allow(clippy::too_many_arguments)]
+fn lassoscan_dump(
+    dir: &std::path::Path,
+    context: LassoContext<'_>,
+    seed: u64,
+    x: &BitMatrix,
+    y: &Bits,
+    train: &Bits,
+    fit_m: &Bits,
+    val: &Bits,
+    feats: &[u32],
+    path: Vec<lasso::LassoFit>,
+    refit: Vec<lasso::LassoFit>,
+    result: &Result<(Scored, Option<lasso::LassoModel>)>,
+) {
+    let fold = context
+        .outer_fold
+        .map_or("final".to_string(), |f| f.to_string());
+    let fits = |v: &[lasso::LassoFit]| -> Vec<serde_json::Value> {
+        v.iter()
+            .map(|f| serde_json::json!({"model": f.model, "convergence": f.convergence}))
+            .collect()
+    };
+    let ones = |b: &Bits| b.iter_ones().collect::<Vec<usize>>();
+    let (scores, complexity, audit) = match result {
+        Ok((s, _)) => (s.scores.clone(), Some(s.complexity), s.lasso_fit.clone()),
+        Err(_) => (None, None, None),
+    };
+    let mut v = serde_json::json!({
+        "dataset": context.dataset,
+        "scheme": context.scheme,
+        "outer_fold": context.outer_fold,
+        "seed": seed,
+        "n": x.cols,
+        "y": ones(y),
+        "train": ones(train),
+        "fit": ones(fit_m),
+        "val": ones(val),
+        "features": feats,
+        "path": fits(&path),
+        "refit": fits(&refit),
+        "scores": scores,
+        "complexity": complexity,
+        "audit": audit,
+        "error": result.as_ref().err().map(|e| format!("{e:#}")),
+    });
+    let full = std::env::var("GRM_LASSO_DUMP_FULL").ok()
+        == Some(format!("{}|{}|{}", context.dataset, context.scheme, fold));
+    if full {
+        let columns: Vec<Vec<usize>> = feats
+            .iter()
+            .map(|&f| {
+                let row = x.row(f as usize);
+                let mut c = Vec::new();
+                for (wi, &word) in row.iter().enumerate() {
+                    let mut w = word;
+                    while w != 0 {
+                        let i = wi * 64 + w.trailing_zeros() as usize;
+                        if i < x.cols {
+                            c.push(i);
+                        }
+                        w &= w - 1;
+                    }
+                }
+                c
+            })
+            .collect();
+        v["columns"] = serde_json::json!(columns);
+    }
+    let name = format!("{}__{}__{}.json", context.dataset, context.scheme, fold);
+    if let Err(e) = std::fs::write(dir.join(&name), v.to_string()) {
+        eprintln!("lassoscan dump: cannot write {name}: {e}");
+    }
 }
 
